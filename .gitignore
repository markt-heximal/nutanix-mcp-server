# Environment
# Covers .env, .env.local, .env.bak-*, .facade.env, deploy/*.env, etc.
# Template files are re-included below — they are meant to be committed.
.env
.env.*
*.env
!.env.example
!*.env.example

# The globs above already cover .facade.env, .management.env and *.local.env.
# users.json holds management-API credentials and matches none of them.
users.json

.venv/
venv/
env/

# Backups and editor leftovers (routinely contain copies of the above)
*.bak
*.bak-*
*.orig
*~

# Keys and certificates
*.pem
*.key
*.p12
*.pfx

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Local agent/tooling state (machine-specific, not project content)
.swarm/
.claude-flow/
ruvector.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/settings.local.json
