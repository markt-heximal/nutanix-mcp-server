# Copy to the repo root as .management.env, fill in, then: chmod 600 .management.env
# This file configures the AUTHENTICATED management API (management_api.py),
# which exposes the full read+write Nutanix tool surface to a frontend.
#
# It is loaded IN ADDITION to .env (the NUTANIX_* connection settings the MCP
# server already uses). Keep both files chmod 600 and gitignored.

# --- JWT session signing -----------------------------------------------------
# Generate once and keep stable (rotating it logs everyone out):
#   openssl rand -hex 32
MGMT_JWT_SECRET=replace-with-openssl-rand-hex-32

# How long a login stays valid, in seconds (default 3600 = 1 hour).
MGMT_TOKEN_TTL_SECONDS=3600

# --- Users -------------------------------------------------------------------
# Prefer a file so secrets never sit in the process env / systemd unit:
MGMT_USERS_FILE=/etc/nutanix-mgmt/users.json
# ...or inline as JSON (less preferred):
# MGMT_USERS={"alice":{"password_hash":"pbkdf2_sha256$...","role":"admin"}}
#
# Generate password hashes with:
#   python scripts/mgmt_user.py alice admin
# Roles: viewer (read-only) | operator (non-destructive writes) | admin (all,
# including destructive delete/power-off/update/restore).

# --- CORS --------------------------------------------------------------------
# Exact origin(s) of your deployed frontend, comma-separated. Required for the
# browser to call the API cross-origin.
MGMT_CORS_ORIGINS=https://your-app.lovable.app
