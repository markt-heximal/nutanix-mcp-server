[Unit]
Description=Nutanix MCP server (HTTP transport, PE-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=markt
WorkingDirectory=/home/markt/nutanix-mcp-server
ExecStart=/usr/bin/python3 -m nutanix_mcp --http --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
