[Unit]
Description=Nutanix PE read-only facade (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=markt
WorkingDirectory=/home/markt/nutanix-mcp-server
EnvironmentFile=/home/markt/nutanix-mcp-server/.facade.env
ExecStart=/usr/bin/python3 -m uvicorn pe_facade:app --host 127.0.0.1 --port 9770
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
