# Nutanix Prism Central connection
NUTANIX_HOST=your-prism-central.example.com
NUTANIX_PORT=9440
NUTANIX_USERNAME=your-username
NUTANIX_PASSWORD=your-password
NUTANIX_VERIFY_SSL=true
NUTANIX_TIMEOUT=30

# Prism Element host allowlist (comma-separated IPs/hostnames)
# Leave empty to allow any PE host, or restrict to known CVMs
# NUTANIX_ALLOWED_PE_HOSTS=10.0.0.1,10.0.0.2,10.0.0.3

# Optional Prism Element credentials. Set these ONLY if the PE admin
# password differs from Prism Central's — pe_* tools (storage, health,
# data protection) will otherwise reuse NUTANIX_USERNAME/NUTANIX_PASSWORD
# and fail with HTTP 401 against a PE that has a different admin password.
# NUTANIX_PE_USERNAME=admin
# NUTANIX_PE_PASSWORD=your-pe-password

# Diagnostic log level written to stderr (DEBUG, INFO, WARNING, ERROR)
# NUTANIX_LOG_LEVEL=INFO
